# Copy to .env.local (app config) and .env (DATABASE_URL for the Prisma CLI).

# LLM provider
OPENROUTER_API_KEY=sk-or-...

# Auth (NextAuth + Google OAuth)
NEXTAUTH_URL=https://scriptsmith.web.id
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Client-side ID (sama dengan GOOGLE_CLIENT_ID) untuk Google One Tap / tombol Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id
ADMIN_EMAILS=youremail@gmail.com

# Database (SQLite for MVP)
DATABASE_URL=file:./scriptsmith.db

# --- Langganan ScriptSmith ---
# Kuota naskah gratis per hari untuk user FREE
FREE_DAILY_LIMIT=2
# Harga langganan (Rupiah/bulan)
# PRO_TEXT  = mode hasil "Teks saja"
# PRO_VIDEO = mode hasil "Teks + prompt video AI"
PRICE_TEXT=49000
PRICE_VIDEO=75000
# Durasi akses PRO per pembayaran (hari)
PRO_DAYS=30
# Fallback manual (opsional): nomor WA + info transfer
UPGRADE_WHATSAPP=628xxxxxxxxxx
PAYMENT_INFO=Transfer Rp ... ke rekening ... lalu kirim bukti ke WA.

# --- Midtrans (Snap) ---
# Dapatkan dari dashboard Midtrans (sandbox/production)
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_IS_PRODUCTION=false
# Client key juga diekspos ke browser (aman — dipakai Snap)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-...
